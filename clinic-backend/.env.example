# Clinic AI - Backend Configuration (.env.example)
# Copy to .env: cp .env.example .env

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=clinic_ai

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min32chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_key_change_me

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting (@nestjs/throttler)
RATE_LIMIT_DURATION=60000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
DISABLE_CRONS=false

# AI & Telephony Integration
GROQ_API_KEY=gsk_your_groq_api_key_here
BOT_API_KEY=your_shared_internal_bot_api_key
