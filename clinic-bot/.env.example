# Clinic AI - Voice Bot Configuration (.env.example)
# Copy to .env: cp .env.example .env

# Speech-to-Text & Text-to-Speech
DEEPGRAM_API_KEY=your_deepgram_api_key
CARTESIA_API_KEY=your_cartesia_api_key

# Fast Conversational LLM (Groq API Key Rotation)
GROQ_API_KEY=gsk_primary_key
GROQ_API_KEY_2=gsk_fallback_key_2
GROQ_API_KEY_3=gsk_fallback_key_3
GROQ_API_KEY_4=gsk_fallback_key_4
GROQ_API_KEY_5=gsk_fallback_key_5
GROQ_API_KEY_6=gsk_fallback_key_6
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM / OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key

# Backend Integration
BACKEND_URL=http://localhost:3001
BOT_API_KEY=your_shared_internal_bot_api_key

# Daily WebRTC (Optional)
DAILY_API_KEY=your_daily_api_key

# Telephony: Twilio Integration
TWILIO_ACCOUNT_SID=AC_your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Telephony: Exotel Integration (Indian Cloud Telephony)
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_ACCOUNT_SID=your_exotel_sid
EXOTEL_PHONE_NUMBER=your_exotel_virtual_number
EXOTEL_FLOW_ID=your_exotel_flow_app_id

# Telephony: SignalWire Integration (Optional)
SIGNALWIRE_SPACE=your_space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id
SIGNALWIRE_API_TOKEN=your_api_token
SIGNALWIRE_PHONE_NUMBER=+1234567890
